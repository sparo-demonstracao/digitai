# Você NÃO precisa mexer neste arquivo: tudo pode ser configurado na tela Configurações do app.
# Se preferir configurar à mão, copie este arquivo para .env (na mesma pasta) e preencha.
# O .env fica só no seu computador e nunca é enviado para o GitHub.

# Transcrição: "openrouter" (padrão, uma chave só para tudo), "groq" ou "openai"
TRANSCRIBE_PROVIDER=openrouter
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Opcional: troque o modelo de transcrição (ex.: openai/whisper-large-v3-turbo)
# TRANSCRIBE_MODEL=

# Limpeza e formatação do texto com Claude (pelo OpenRouter, com a mesma chave, ou direto na Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# "off" cola o texto exatamente como foi transcrito
CLEANUP=on

# Idioma principal (código ISO, ex.: pt, en, es). Deixe vazio para detectar sozinho.
LANGUAGE=pt

# Atalho para segurar enquanto fala. Combine com "+":
#   modificadores: ctrl, leftctrl, rightctrl, shift, leftshift, rightshift, alt, leftalt, rightalt, win
#   e no máximo uma tecla comum: a-z, 0-9, space, f1..f12
# Com tecla comum (ex.: leftalt+v), segurar dita e um toque rápido continua indo para o app.
HOTKEY=leftalt+v

# Palavras que o ditado deve escrever certo (nomes, marcas, termos técnicos), separadas por vírgula
DICIONARIO=

# Desenvolvimento
# TESTE_TEXTO=   pula a transcrição e cola este texto (testa atalho e colagem sem gastar API)
# TESTE_AUDIO=   caminho de um .wav transcrito no lugar do microfone (testa a transcrição sem falar)
# DEBUG_TECLAS=1 registra no log cada tecla que o atalho enxerga
# DEBUG_AUDIO=1  salva o último áudio gravado em %APPDATA%\DigitAI\ultimo-audio.wav
